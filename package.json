{
  "name": "youtube-analytics-mcp",
  "version": "1.0.0",
  "description": "Open-source MCP server for analyzing YouTube videos and Shorts (transcripts, hooks, metadata, and audience comments)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "youtube-analytics-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "shorts",
    "analytics",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "youtube-transcript": "1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
